# Server port (optional, default 3000)
PORT=3000

# Required API secret — change this to a long random string
# All requests must send this token or they will be rejected (401)
#
# How to send:
#   Authorization: Bearer YOUR_TOKEN_HERE
#   OR header: x-api-token: YOUR_TOKEN_HERE
#   OR query:  ?token=YOUR_TOKEN_HERE
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=change_me_to_a_long_random_secret
